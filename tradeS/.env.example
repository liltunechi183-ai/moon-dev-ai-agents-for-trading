# Alpaca paper account — free at https://app.alpaca.markets/signup
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# SEC EDGAR requires an identifying User-Agent
SEC_EDGAR_USER_AGENT="TradeS personal project you@example.com"

DATABASE_PATH=./data/trades.db

# Optional: Reddit sentiment (create a "script" app at reddit.com/prefs/apps).
# Without keys the Reddit source is skipped (unauthenticated access is 403).
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# Logins OFF by default. Set AUTH_ENABLED=true + restart to enable sharing;
# first account becomes owner, later signups are read-only guests.
# AUTH_ENABLED=true
AUTH_SECRET=            # any long random string, e.g. openssl rand -hex 32

# Optional: congressional trades via Quiver Quantitative (free key).
# QUIVER_API_KEY=

# Live trading — leave unset until deliberately enabling (triple unlock).
# ALPACA_ALLOW_LIVE=false
# ALPACA_LIVE_KEY_ID=
# ALPACA_LIVE_SECRET_KEY=

# NOTE: Do NOT add ANTHROPIC_API_KEY. See AGENTS.md.
